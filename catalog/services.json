    {
      "id": "cohere",
      "name": "Cohere",
      "category": "llm",
      "docs": "https://docs.cohere.com/reference/chat",
      "hosts": [
        "api.cohere.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "baseUrl": {
        "var": "CO_API_URL"
      },
      "envVars": [
        "CO_API_KEY",
        "COHERE_API_KEY"
      ],
      "statusPage": "https://status.cohere.com",
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/v2/chat"
          },
          {
            "name": "embed",
            "method": "POST",
            "path": "/v2/embed"
          },
          {
            "name": "rerank",
            "method": "POST",
            "path": "/v2/rerank"
          },
          {
            "name": "chat_v1",
            "method": "POST",
            "path": "/v1/chat"
          }
        ],
        "model": "request:model",
        "input": [
          "usage.billed_units.input_tokens|delta.usage.billed_units.input_tokens|meta.billed_units.input_tokens|response.meta.billed_units.input_tokens"
        ],
        "output": [
          "usage.billed_units.output_tokens|delta.usage.billed_units.output_tokens|meta.billed_units.output_tokens|response.meta.billed_units.output_tokens"
        ],
        "units": [

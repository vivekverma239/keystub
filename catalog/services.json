{
  "version": 1,
  "services": [
    {
      "id": "openai",
      "name": "OpenAI",
      "category": "llm",
      "docs": "https://platform.openai.com/docs/api-reference",
      "hosts": [
        "api.openai.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "baseUrl": {
        "var": "OPENAI_BASE_URL",
        "path": "/v1"
      },
      "envVars": [
        "OPENAI_API_KEY"
      ],
      "statusPage": "https://status.openai.com",
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/v1/chat/completions"
          },
          {
            "name": "responses",
            "method": "POST",
            "path": "/v1/responses"
          },
          {
            "name": "compact",
            "method": "POST",
            "path": "/v1/responses/compact"
          },
          {
            "name": "embeddings",
            "method": "POST",
            "path": "/v1/embeddings"
          },
          {
            "name": "completions",
            "method": "POST",
            "path": "/v1/completions"
          }
        ],
        "model": "model|response.model|request:model",
        "input": [
          "usage.prompt_tokens|usage.input_tokens|response.usage.input_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens|usage.input_tokens_details.cached_tokens|response.usage.input_tokens_details.cached_tokens"
        ],
        "cacheWrite": [
          "usage.prompt_tokens_details.cache_write_tokens|usage.input_tokens_details.cache_write_tokens|response.usage.input_tokens_details.cache_write_tokens"
        ],
        "output": [
          "usage.completion_tokens|usage.output_tokens|response.usage.output_tokens"
        ],
        "quota": {
          "requests": "x-ratelimit-remaining-requests",
          "tokens": "x-ratelimit-remaining-tokens"
        }
      }
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "category": "llm",
      "docs": "https://docs.anthropic.com/en/api",
      "hosts": [
        "api.anthropic.com"
      ],
      "auth": {
        "header": "x-api-key",
        "format": "{key}"
      },
      "baseUrl": {
        "var": "ANTHROPIC_BASE_URL"
      },
      "envVars": [
        "ANTHROPIC_API_KEY"
      ],
      "statusPage": "https://status.claude.com",
      "usage": {
        "operations": [
          {
            "name": "messages",
            "method": "POST",
            "path": "/v1/messages"
          },
          {
            "name": "count_tokens",
            "method": "POST",
            "path": "/v1/messages/count_tokens"
          },
          {
            "name": "chat",
            "method": "POST",
            "path": "/v1/chat/completions"
          }
        ],
        "model": "model|message.model|request:model",
        "input": [
          "usage.input_tokens|message.usage.input_tokens|usage.prompt_tokens",
          "usage.cache_read_input_tokens|message.usage.cache_read_input_tokens",
          "usage.cache_creation_input_tokens|message.usage.cache_creation_input_tokens"
        ],
        "cached": [
          "usage.cache_read_input_tokens|message.usage.cache_read_input_tokens"
        ],
        "cacheWrite": [
          "usage.cache_creation_input_tokens|message.usage.cache_creation_input_tokens"
        ],
        "output": [
          "usage.output_tokens|message.usage.output_tokens|usage.completion_tokens"
        ],
        "quota": {
          "requests": "anthropic-ratelimit-requests-remaining",
          "tokens": "anthropic-ratelimit-tokens-remaining"
        }
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "category": "code",
      "docs": "https://docs.github.com/en/rest",
      "hosts": [
        "api.github.com",
        "uploads.github.com",
        "github.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "GH_TOKEN",
        "GITHUB_TOKEN"
      ]
    },
    {
      "id": "stripe",
      "name": "Stripe",
      "category": "payments",
      "docs": "https://docs.stripe.com/api",
      "hosts": [
        "api.stripe.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "STRIPE_API_KEY"
      ]
    },
    {
      "id": "resend",
      "name": "Resend",
      "category": "email",
      "docs": "https://resend.com/docs/api-reference",
      "hosts": [
        "api.resend.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "RESEND_API_KEY"
      ]
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "category": "infrastructure",
      "docs": "https://developers.cloudflare.com/api/",
      "note": "API tokens only; the legacy global key (X-Auth-Key plus email) isn't supported.",
      "hosts": [
        "api.cloudflare.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "CLOUDFLARE_API_TOKEN"
      ]
    },
    {
      "id": "vercel",
      "name": "Vercel",
      "category": "infrastructure",
      "docs": "https://vercel.com/docs/rest-api",
      "note": "The Vercel CLI rejects \"-\" in tokens, so it gets the compact form.",
      "hosts": [
        "api.vercel.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "VERCEL_TOKEN={key_compact}"
      ]
    },
    {
      "id": "gemini",
      "name": "Google Gemini",
      "category": "llm",
      "docs": "https://ai.google.dev/api",
      "note": "The OpenAI-compatible endpoints take the key in Authorization: Bearer, which also works.",
      "hosts": [
        "generativelanguage.googleapis.com"
      ],
      "auth": {
        "header": "x-goog-api-key",
        "format": "{key}"
      },
      "baseUrl": {
        "var": "GOOGLE_GEMINI_BASE_URL"
      },
      "envVars": [
        "GOOGLE_API_KEY",
        "GEMINI_API_KEY"
      ],
      "statusPage": "https://aistudio.google.com/status",
      "usage": {
        "operations": [
          {
            "name": "generate",
            "method": "POST",
            "path": "/*/models/{model}:generateContent"
          },
          {
            "name": "stream",
            "method": "POST",
            "path": "/*/models/{model}:streamGenerateContent"
          },
          {
            "name": "embed",
            "method": "POST",
            "path": "/*/models/{model}:embedContent"
          },
          {
            "name": "batch_embed",
            "method": "POST",
            "path": "/*/models/{model}:batchEmbedContents"
          },
          {
            "name": "count_tokens",
            "method": "POST",
            "path": "/*/models/{model}:countTokens"
          },
          {
            "name": "interactions",
            "method": "POST",
            "path": "/v1beta/interactions"
          },
          {
            "name": "chat",
            "method": "POST",
            "path": "/v1beta/openai/chat/completions"
          },
          {
            "name": "embeddings",
            "method": "POST",
            "path": "/v1beta/openai/embeddings"
          }
        ],
        "model": "modelVersion|model|path:model|request:model",
        "input": [
          "usageMetadata.promptTokenCount|usage.prompt_tokens"
        ],
        "cached": [
          "usageMetadata.cachedContentTokenCount"
        ],
        "output": [
          "usageMetadata.candidatesTokenCount|usage.completion_tokens",
          "usageMetadata.thoughtsTokenCount"
        ]
      }
    },
    {
      "id": "mistral",
      "name": "Mistral",
      "category": "llm",
      "docs": "https://docs.mistral.ai/api/",
      "hosts": [
        "api.mistral.ai",
        "api.eu.mistral.ai",
        "api.us.mistral.ai"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "MISTRAL_API_KEY"
      ],
      "statusPage": "https://status.mistral.ai",
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/v1/chat/completions"
          },
          {
            "name": "fim",
            "method": "POST",
            "path": "/v1/fim/completions"
          },
          {
            "name": "embeddings",
            "method": "POST",
            "path": "/v1/embeddings"
          }
        ],
        "model": "model|response.model|request:model",
        "input": [
          "usage.prompt_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens"
        ],
        "output": [
          "usage.completion_tokens"
        ]
      }
    },
    {
      "id": "groq",
      "name": "Groq",
      "category": "llm",
      "docs": "https://console.groq.com/docs/api-reference",
      "hosts": [
        "api.groq.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "baseUrl": {
        "var": "GROQ_BASE_URL"
      },
      "envVars": [
        "GROQ_API_KEY"
      ],
      "statusPage": "https://groqstatus.com",
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/openai/v1/chat/completions"
          },
          {
            "name": "responses",
            "method": "POST",
            "path": "/openai/v1/responses"
          },
          {
            "name": "transcriptions",
            "method": "POST",
            "path": "/openai/v1/audio/transcriptions"
          },
          {
            "name": "translations",
            "method": "POST",
            "path": "/openai/v1/audio/translations"
          },
          {
            "name": "speech",
            "method": "POST",
            "path": "/openai/v1/audio/speech"
          }
        ],
        "model": "model|response.model|request:model",
        "input": [
          "usage.prompt_tokens|x_groq.usage.prompt_tokens|usage.input_tokens|response.usage.input_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens|x_groq.usage.prompt_tokens_details.cached_tokens"
        ],
        "output": [
          "usage.completion_tokens|x_groq.usage.completion_tokens|usage.output_tokens|response.usage.output_tokens"
        ],
        "status": {
          "498": "upstream_error"
        },
        "quota": {
          "requests": "x-ratelimit-remaining-requests",
          "tokens": "x-ratelimit-remaining-tokens"
        }
      }
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "category": "llm",
      "docs": "https://openrouter.ai/docs/api-reference/authentication",
      "hosts": [
        "openrouter.ai"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "baseUrl": {
        "var": "OPENROUTER_BASE_URL",
        "path": "/api/v1"
      },
      "envVars": [
        "OPENROUTER_API_KEY"
      ],
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/api/v1/chat/completions"
          },
          {
            "name": "responses",
            "method": "POST",
            "path": "/api/v1/responses"
          },
          {
            "name": "completions",
            "method": "POST",
            "path": "/api/v1/completions"
          },
          {
            "name": "embeddings",
            "method": "POST",
            "path": "/api/v1/embeddings"
          },
          {
            "name": "messages",
            "method": "POST",
            "path": "/api/v1/messages"
          }
        ],
        "model": "model|response.model|request:model",
        "input": [
          "usage.prompt_tokens|usage.input_tokens|response.usage.input_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens"
        ],
        "cacheWrite": [
          "usage.prompt_tokens_details.cache_write_tokens"
        ],
        "output": [
          "usage.completion_tokens|usage.output_tokens|response.usage.output_tokens"
        ],
        "cost": "usage.cost|response.usage.cost"
      }
    },
    {
      "id": "vercel-ai-gateway",
      "name": "Vercel AI Gateway",
      "category": "llm",
      "docs": "https://vercel.com/docs/ai-gateway/authentication-and-byok",
      "note": "The token goes in Authorization as a bearer token, as the OpenAI SDK and the AI SDK send it; the Anthropic SDK and Claude Code need ANTHROPIC_AUTH_TOKEN, not ANTHROPIC_API_KEY (x-api-key).",
      "hosts": [
        "ai-gateway.vercel.sh"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "AI_GATEWAY_API_KEY"
      ],
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/v1/chat/completions"
          },
          {
            "name": "responses",
            "method": "POST",
            "path": "/v1/responses"
          },
          {
            "name": "embeddings",
            "method": "POST",
            "path": "/v1/embeddings"
          },
          {
            "name": "messages",
            "method": "POST",
            "path": "/v1/messages"
          },
          {
            "name": "count_tokens",
            "method": "POST",
            "path": "/v1/messages/count_tokens"
          }
        ],
        "model": "model|response.model|message.model|request:model",
        "input": [
          "usage.prompt_tokens|usage.input_tokens|response.usage.input_tokens|message.usage.input_tokens",
          "usage.cache_read_input_tokens|message.usage.cache_read_input_tokens",
          "usage.cache_creation_input_tokens|message.usage.cache_creation_input_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens|usage.input_tokens_details.cached_tokens|response.usage.input_tokens_details.cached_tokens|usage.cache_read_input_tokens|message.usage.cache_read_input_tokens"
        ],
        "cacheWrite": [
          "usage.cache_creation_input_tokens|message.usage.cache_creation_input_tokens"
        ],
        "output": [
          "usage.completion_tokens|usage.output_tokens|response.usage.output_tokens|message.usage.output_tokens"
        ],
        "cost": "usage.cost|response.usage.cost"
      }
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "category": "llm",
      "docs": "https://api-docs.deepseek.com/",
      "hosts": [
        "api.deepseek.com"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "DEEPSEEK_API_KEY"
      ],
      "statusPage": "https://status.deepseek.com",
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/chat/completions"
          },
          {
            "name": "responses",
            "method": "POST",
            "path": "/responses"
          },
          {
            "name": "fim",
            "method": "POST",
            "path": "/beta/completions"
          }
        ],
        "model": "model|response.model|request:model",
        "input": [
          "usage.prompt_tokens"
        ],
        "cached": [
          "usage.prompt_cache_hit_tokens|usage.prompt_tokens_details.cached_tokens"
        ],
        "output": [
          "usage.completion_tokens"
        ]
      }
    },
    {
      "id": "zai",
      "name": "Z.AI",
      "category": "llm",
      "docs": "https://docs.z.ai/api-reference/introduction",
      "note": "General keys use /api/paas/v4; GLM Coding Plan keys use /api/coding/paas/v4, or /api/anthropic for Anthropic-style clients, which need ANTHROPIC_AUTH_TOKEN, not ANTHROPIC_API_KEY (x-api-key).",
      "hosts": [
        "api.z.ai"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "ZAI_API_KEY"
      ],
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/api/paas/v4/chat/completions"
          },
          {
            "name": "chat",
            "method": "POST",
            "path": "/api/coding/paas/v4/chat/completions"
          },
          {
            "name": "messages",
            "method": "POST",
            "path": "/api/anthropic/v1/messages"
          }
        ],
        "model": "model|response.model|message.model|request:model",
        "input": [
          "usage.prompt_tokens|usage.input_tokens|message.usage.input_tokens",
          "usage.cache_read_input_tokens|message.usage.cache_read_input_tokens",
          "usage.cache_creation_input_tokens|message.usage.cache_creation_input_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens|usage.cache_read_input_tokens|message.usage.cache_read_input_tokens"
        ],
        "cacheWrite": [
          "usage.cache_creation_input_tokens|message.usage.cache_creation_input_tokens"
        ],
        "output": [
          "usage.completion_tokens|usage.output_tokens|message.usage.output_tokens"
        ]
      }
    },
    {
      "id": "xai",
      "name": "xAI",
      "category": "llm",
      "docs": "https://docs.x.ai/docs/api-reference",
      "note": "REST API. The official Python SDK uses gRPC, which needs the proxy, not quick start.",
      "hosts": [
        "api.x.ai"
      ],
      "auth": {
        "header": "Authorization",
        "format": "Bearer {key}"
      },
      "envVars": [
        "XAI_API_KEY"
      ],
      "statusPage": "https://status.x.ai",
      "usage": {
        "operations": [
          {
            "name": "chat",
            "method": "POST",
            "path": "/v1/chat/completions"
          },
          {
            "name": "responses",
            "method": "POST",
            "path": "/v1/responses"
          },
          {
            "name": "completions",
            "method": "POST",
            "path": "/v1/completions"
          },
          {
            "name": "messages",
            "method": "POST",
            "path": "/v1/messages"
          }
        ],
        "model": "model|response.model|request:model",
        "input": [
          "usage.prompt_tokens|usage.input_tokens|response.usage.input_tokens"
        ],
        "cached": [
          "usage.prompt_tokens_details.cached_tokens|usage.input_tokens_details.cached_tokens|response.usage.input_tokens_details.cached_tokens"
        ],
        "output": [
          "usage.completion_tokens|usage.output_tokens|response.usage.output_tokens",
          "usage.completion_tokens_details.reasoning_tokens|usage.output_tokens_details.reasoning_tokens|response.usage.output_tokens_details.reasoning_tokens"
        ],
        "cost": "usage.cost_in_usd_ticks|response.usage.cost_in_usd_ticks",
        "costPerUsd": 10000000000
      }
    },
    {

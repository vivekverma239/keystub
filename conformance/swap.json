  "scrub": [
    {
      "name": "the real key in a Location header and a next link, plain and query-escaped (Mapbox)",
      "service": "mapbox",
      "realKey": "pk.real+key",
      "token": "sk-stub-0a1b2c3d",
      "response": {
        "headers": {
          "Location": "https://api.mapbox.com/x?access_token=pk.real%2Bkey",
          "Content-Length": "120"
        },
        "body": "{\"next\":\"https://api.mapbox.com/x?access_token=pk.real%2Bkey&page=2\",\"echo\":\"pk.real+key\"}"
      },
      "client": {
        "headers": {
          "Location": "https://api.mapbox.com/x?access_token=sk-stub-0a1b2c3d",
          "Content-Length": ""
        },
        "body": "{\"next\":\"https://api.mapbox.com/x?access_token=sk-stub-0a1b2c3d&page=2\",\"echo\":\"sk-stub-0a1b2c3d\"}"
      }
    },
